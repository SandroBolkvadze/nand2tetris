class Direction2d {
    field int index;

    constructor Direction2d new(char direction) {
        let index = Direction2d.directionToIndex(direction);
        return this;
    }

    method Location2d getDisplacement() {
        // 'L' case
        if (index = 0) {
            return Location2d.new(-1, 0);
        }
        // 'U' case
        if (index = 1) {
            return Location2d.new(0, -1);
        }
        // 'R' case
        if (index = 2) {
            return Location2d.new(1, 0);
        }
        // 'D' case
        if (index = 3) {    
            return Location2d.new(0, 1);
        }

        return 0;
    }

    method void turnClockwise() {
        let index = index + 1;
        if (index > 3) {
            let index = 0;
        }
        return;
    }

    method void turnCounterClockwise() {
        let index = index - 1;
        if (index < 0) {
            let index = 3;
        }
        return;
    }

    method void setDirection(char direction) {
        let index = Direction2d.directionToIndex(direction);
        return;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    function int directionToIndex(char direction) {
        // 'L' case
        if (direction = 76) {
            return 0;
        }
        // 'U' case
        if (direction = 85) {
            return 1;
        }
        // 'R' case
        if (direction = 82) {
            return 2;
        }
        // 'D' case
        if (direction = 68) {
            return 3;
        } 

        return -1;
    }

}

