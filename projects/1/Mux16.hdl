// File name: projects/1/Mux16.hdl
/**
 * 16-bit multiplexor: 
 * for i = 0, ..., 15:
 * if (sel = 0) out[i] = a[i], else out[i] = b[i]
 */
CHIP Mux16 {
    IN a[16], b[16], sel;
    OUT out[16];

    PARTS:
    Not16(in[0]=sel, in[1]=sel, in[2]=sel, in[3]=sel, in[4]=sel, in[5]=sel, in[6]=sel, in[7]=sel, in[8]=sel, in[9]=sel, in[10]=sel, in[11]=sel, in[12]=sel, in[13]=sel, in[14]=sel, in[15]=sel, out=notsel16);
    Not16(in=notsel16, out=sel16);

    And16(a=a, b=notsel16, out=aAndNotsel16);
    And16(a=b, b=sel16, out=aAndsel16);
    
    Or16(a=aAndNotsel16, b=aAndsel16, out=out);
}
