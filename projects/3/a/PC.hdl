// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], inc, load, reset;
    OUT out[16];
    
    PARTS:
    Inc16(in=reg, out=increg);
    
    Or(a=reset, b=load, out=resetorload);
    Or(a=resetorload, b=inc, out=resetOrloadOrinc);
    
    Mux16(a=increg, b=in, sel=load, out=incorin);
    Mux16(a=incorin, b=false, sel=reset, out=incOrinOrzero);
    
    Register(in=incOrinOrzero, load=resetOrloadOrinc, out=out, out=reg);
}
